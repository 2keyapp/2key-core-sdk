# Delegate Permissions CLI — environment
#
# Copy to `.env` for a local shell (`set -a && source .env && set +a`).
# Cargo does not load this file by itself.
#
# Product builds: export these (or put them in `.cargo/config.toml`) when you
# `cargo build --release -p dp-cli`, then rename the binary (idr, acme, …).
# Runtime values always override compiled-in defaults.

# =============================================================================
# Required at product build (baked into the exe)
# =============================================================================

# Better Auth base URL including the auth mount (no trailing slash).
# Example production: https://api.idr.to/api/auth
DP_BACKEND_URL=http://localhost:3000/api/auth

# Product / binary brand: clap name, user-agent, default state dir ~/.{name}
DP_PRODUCT_NAME=idr

# =============================================================================
# Optional at product build
# =============================================================================

# Machine identity separator: {name}{sep}{entity}  e.g. db1--acme.com
DP_SEPARATOR=--

# =============================================================================
# Runtime only (never compiled in)
# =============================================================================

# Optional OAuth device-flow client_id (default: ${DP_PRODUCT_NAME}-cli)
# DP_CLIENT_ID=idr-cli

# Optional one-shot override. Prefer `idr auth login` (writes $DP_STATE_DIR/session).
# Cookie form (from a signed-in browser):
#   DP_AUTH_TOKEN='better-auth.session_token=...'
# Bearer form (device-code access_token):
#   DP_AUTH_TOKEN='eyJ...'
DP_AUTH_TOKEN=

# Optional. Default: ~/.${DP_PRODUCT_NAME}  (e.g. ~/.idr)
# Keys live under $DP_STATE_DIR/identity/ (0600). Do not point this at a shared dir.
# DP_STATE_DIR=/var/lib/idr
