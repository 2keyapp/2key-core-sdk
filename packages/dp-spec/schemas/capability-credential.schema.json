{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2key.app/schemas/capability-credential.schema.json",
  "title": "CapabilityCredential",
  "type": "object",
  "required": [
    "version",
    "kind",
    "entityId",
    "ski",
    "publicJwk",
    "permissions",
    "issuerSki",
    "notBefore",
    "notAfter",
    "signature"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": {
      "enum": [
        "entity_root",
        "root_admin",
        "interim_admin",
        "zone_authority",
        "machine"
      ]
    },
    "entityId": { "type": "string", "minLength": 1 },
    "ski": { "type": "string", "minLength": 1 },
    "publicJwk": { "type": "object" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "scope", "delegable"],
        "properties": {
          "action": { "type": "string" },
          "scope": { "type": "object" },
          "delegable": { "type": "boolean" }
        }
      }
    },
    "zone": { "type": "string" },
    "host": { "type": "string" },
    "issuerSki": { "type": "string" },
    "notBefore": { "type": "string", "format": "date-time" },
    "notAfter": { "type": "string", "format": "date-time" },
    "package": { "enum": ["personal", "enterprise"] },
    "platformCosign": {
      "type": "object",
      "required": ["kid", "signedAt", "signature"],
      "properties": {
        "kid": { "type": "string" },
        "signedAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string" }
      }
    },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
